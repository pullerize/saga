generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Authentication & Users ──
// Roles: ADMIN (full control), MANAGER (own staff), PARTNER (external)
// Statuses: ACTIVE, BLOCKED, PENDING

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  phone        String?
  role         String  @default("PARTNER")
  status       String  @default("PENDING")
  // companyName хранится как денормализованное имя для совместимости с
  // существующими местами, где идёт фильтрация ClientCard.companyName.
  // companyId — связь на сущность Company (задаётся при создании из админки).
  companyName  String?
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])

  partnerPrices PartnerPrice[]
  calculations  Calculation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// ── Companies (партнёрские компании) ──
// «Saga Group» — компания по умолчанию для внутренних менеджеров и админов.
model Company {
  id        String  @id @default(cuid())
  name      String  @unique
  logoUrl   String?
  // Шоурумы / филиалы компании: Array<{ name: string, address: string }>.
  // Редактируются вместе с компанией в админке (/admin/companies).
  showrooms Json?
  users     User[]
  prices    CompanyPrice[]
  glassPrices CompanyGlassPrice[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Door Systems ──

model DoorSystem {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  sortOrder    Int     @default(0)
  minWidth     Int
  maxWidth     Int
  maxFullWidth Int?
  hasExtraField Boolean @default(false)
  minHeight    Int     @default(1800)
  maxHeight    Int     @default(3500)
  isActive     Boolean @default(true)

  videoUrl         String?
  posterUrl        String?
  tooltipWidthUrl  String?
  tooltipHeightUrl String?
  tooltipOpenUrl   String?

  subsystems   Subsystem[]
  calculations Calculation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subsystem {
  id        String     @id @default(cuid())
  systemId  String
  system    DoorSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  name      String
  minWidth  Int
  maxWidth  Int
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  videoUrl  String?
  posterUrl String?

  params    Json // flexible JSON for all subsystem-specific parameters
  formulas  Json? // { "door_width": "(full_width + 32) / num_doors" }
  // Кастомные диапазоны размеров для подбора схем «Вид системы»/«Вид сверху».
  // Формат: { "heightBands": [min, t1, t2, max], "widthBands": [min, t1, t2, max] }.
  // null → используются дефолтные пороги (см. lib/calculations/sizeCategory.ts).
  sizeRanges Json?

  calculations Calculation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([systemId, name])
}

// ── Components & Pricing ──

model Component {
  id           String  @id @default(cuid())
  key          String  @unique
  name         String
  unit         String  @default("шт")
  category     String  @default("component") // "component", "glass", "service", "shotlan"
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)
  defaultPrice Float

  partnerPrices PartnerPrice[]
  companyPrices CompanyPrice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── System-scoped component prices ──
// Цена компонента в рамках конкретной системы. Один и тот же компонент по имени
// (например «Профиль вертикальный (6м)») может стоить в разных системах разную
// цену. Если запись есть — используется в расчёте этой системы. Если нет —
// fallback на Component.defaultPrice. CompanyPrice (от партнёра) перебивает
// и SystemPrice, и defaultPrice.
model SystemPrice {
  id            String   @id @default(cuid())
  systemName    String
  componentName String
  price         Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([systemName, componentName])
  @@index([systemName])
}

// ── Company-scoped component prices ──
// Переопределение цены компонента на уровне компании. Если у компании задана
// своя цена компонента — в расчётах её карточек используется она, иначе
// Component.defaultPrice. Меняется партнёром в /partner/pricing и применяется
// только к его компании, не затрагивая остальные.
model CompanyPrice {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  componentId String
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  price       Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, componentId])
  @@index([companyId])
}

model PartnerPrice {
  id          String    @id @default(cuid())
  partnerId   String
  partner     User      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  componentId String
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  price       Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([partnerId, componentId])
}

// ── Glass Types ──

model GlassType {
  id               String   @id @default(cuid())
  name             String   @unique
  defaultPrice     Float
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  imageUrl         String?
  mobileImageUrl   String?
  restrictedShotlans String  @default("[]") // JSON array as string

  companyPrices CompanyGlassPrice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Цена типа стекла для конкретной компании-партнёра. Если для компании задана
// своя цена стекла — в расчётах её карточек используется она, иначе
// GlassType.defaultPrice.
model CompanyGlassPrice {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  glassTypeId String
  glassType   GlassType @relation(fields: [glassTypeId], references: [id], onDelete: Cascade)
  price       Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, glassTypeId])
  @@index([companyId])
}

// ── Shotlan Options ──

model ShotlanOption {
  id             String  @id @default(cuid())
  name           String  @unique
  sortOrder      Int     @default(0)
  isActive       Boolean @default(true)
  imageUrl       String?
  mobileImageUrl String?
  calcMethod     String
  components     Json?   // { "divider_profile": 25, "bolts_extra": 0.5 }
  formulas       Json?   // { "divider_profile": "Кол-во дверей * 2" }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Additional Services ──

model AdditionalService {
  id          String  @id @default(cuid())
  name        String
  description String?
  defaultPrice Float
  priceUnit   String  @default("per_sqm") // "per_sqm", "fixed", "per_door"
  isActive    Boolean @default(true)
  showInPdf   Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Doors (отдельные SVG двери для каждой подсистемы × шотланки) ──
// Используются в слоте «Вид двери» в превью КП и PDF. При выборе пользователем
// шотланки в калькуляторе — система автоматически подтягивает соответствующий SVG.
// Общий контейнер для предзагруженных SVG-схем подсистемы.
// viewType:
//   "system" — «Вид системы»     (shotlanType = null)
//   "top"    — «Вид сверху»       (shotlanType = null)
//   "door"   — «Вид двери»        (shotlanType = тип шотланки из ShotlanOption.name)
// На каждую комбинацию (systemSlug, subsystemName, viewType, [shotlanType])
// и категорию (heightCategory × widthCategory) — одна SVG. Итого 9 для system,
// 9 для top, 9×N_шотланок для door.
model DoorScheme {
  id            String @id @default(cuid())
  systemSlug    String
  subsystemName String
  viewType      String  @default("door") // "system" | "top" | "door"
  shotlanType   String?                  // обязательно только для viewType="door"
  svgContent    String                   // raw SVG
  // Категории размера проёма (см. lib/calculations/sizeCategory.ts):
  //   heightCategory ∈ {low, mid, high}  — пороги по высоте
  //   widthCategory  ∈ {narrow, mid, long} — пороги по ширине
  heightCategory String?
  widthCategory  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([systemSlug, subsystemName, viewType, shotlanType, heightCategory, widthCategory])
  @@index([systemSlug, subsystemName])
  @@index([systemSlug, subsystemName, viewType])
}

// ── System Formulas (calculation formulas per system/subsystem) ──

model SystemFormula {
  id            String @id @default(cuid())
  systemName    String
  subsystemName String
  componentName String
  formula       String
  sortOrder     Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([systemName, subsystemName, componentName])
}

// ── Param Definitions (characteristics dictionary) ──

model ParamDefinition {
  id       String  @id @default(cuid())
  key      String  @unique
  label    String
  category String  @default("general") // "general", "subsystem", "shotlan"
  price    Float?
  formula  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Subsystem Variants (visual cards per subsystem) ──

model SubsystemVariant {
  id            String @id @default(cuid())
  systemSlug    String
  subsystemName String
  variantName   String // "Вариант 1"
  railImageUrl  String? // фото рельсы
  sortOrder     Int    @default(0)

  schemes SubsystemScheme[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SubsystemVariantItem[]

  @@unique([systemSlug, subsystemName])
}

model SubsystemVariantItem {
  id        String @id @default(cuid())
  variantId String
  variant   SubsystemVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  title     String
  description String @default("")
  iconUrl   String? // path to icon image
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubsystemScheme {
  id        String @id @default(cuid())
  variantId String
  variant   SubsystemVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  label     String   // "Вид спереди", "Вид сбоку", "Вид сверху"
  svgContent String  // raw SVG markup with {{WIDTH}}, {{HEIGHT}}, {{DOOR_WIDTH}} placeholders
  ratioType  String? // "system" | "door" | "top" — тип схемы; legacy "wide"/"square"/"tall" пока тоже остаются
  sortOrder  Int     @default(0)
  // Для ratioType="system" — категории габаритов 3×3. У каждой комбинации
  // (height × width) — своя загруженная SVG. Для top/door — оба null.
  heightCategory String? // "low" (≤1500) | "mid" (1501–2500) | "high" (>2500)
  widthCategory  String? // "narrow" (≤2000) | "mid" (2001–5000) | "long" (>5000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Client Cards ──

model ClientCard {
  id            String @id @default(cuid())
  clientName    String
  clientPhone   String
  clientAddress String @default("")
  managerName   String
  managerPhone  String?
  branch        String
  // Откуда клиент узнал о нас (обязательное поле при создании карточки).
  // referralDetail — кто порекомендовал (компания/человек), для вариантов «по
  // рекомендации …» и «Другое».
  referralSource String @default("")
  referralDetail String @default("")

  systemSlug String?
  systemName String
  subsystem  String
  glass      String
  shotlan    String
  fullWidth  Int
  openWidth  Int    @default(0)
  height     Int
  doorWidth  Int
  totalPrice Float
  components Json // Array<{name, key, qty, price, sum, unit}>
  customServices Json? // Array<{name, description, price}>

  createdByUserId String?
  companyName     String  @default("Saga Group")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyName])
  @@index([createdByUserId])
}

// ── Calculations ──

model Calculation {
  id            String     @id @default(cuid())
  userId        String?
  user          User?      @relation(fields: [userId], references: [id])
  customerName  String
  customerPhone String

  systemId    String
  system      DoorSystem @relation(fields: [systemId], references: [id])
  subsystemId String
  subsystem   Subsystem  @relation(fields: [subsystemId], references: [id])

  fullWidth Int
  openWidth Int?
  height    Int
  doorWidth Int

  glassType   String
  shotlanType String

  components Json  // snapshot: Array<{name, key, qty, price, sum, unit}>
  totalPrice Float
  services   Json? // snapshot of selected additional services

  pdfUrl String?
  status String @default("draft") // "draft", "sent", "ordered", "completed"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Site Content (мини-CMS для публичных страниц landing) ──
// Ключ-значение пары для inline-редактирования текстов/картинок на главной.
// key — стабильный идентификатор (например "home.hero.title").
// type — text | image | video — определяет как использовать value.
// Для type=image|video в value хранится URL уже загруженного через /api/upload файла.
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  type      String   @default("text") // "text" | "image" | "video"
  value     String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Guest Leads (заявки гостей с калькулятора) ──
// Когда неавторизованный посетитель доходит до шага «Результат» в калькуляторе,
// он сначала вводит имя и телефон. После сабмита запись сохраняется здесь и
// гость видит цену. Админ просматривает заявки в /admin/leads.
model GuestLead {
  id            String   @id @default(cuid())
  name          String
  phone         String
  systemSlug    String
  systemName    String
  subsystemName String?
  fullWidth     Int?
  openWidth     Int?
  height        Int?
  doorWidth     Int?
  glassType     String?
  shotlanType   String?
  totalPrice    Float?
  status        String   @default("new") // "new" | "contacted" | "closed"
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
